{
  "name": "@jobpilot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @jobpilot/shared build && pnpm --filter @jobpilot/cv build && next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
