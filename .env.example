# ==========================================================================
# JobPilot — environment configuration
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ==========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL) ----------------------------------------------
# Ports are deliberately off the defaults (5433/6380) so the containers do
# not clash with a Postgres or Redis already installed on the host machine.
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=jobpilot
POSTGRES_PORT=5433
DATABASE_URL=postgresql://jobpilot:change-me-in-production@localhost:5433/jobpilot?schema=public

# --- Redis (queues, rate limiting, cache) -------------------------------
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- API server ----------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api
# Comma-separated list of allowed browser origins. Required in production.
# Only needed when the browser calls the API directly; with the Next proxy
# (API_PROXY_TARGET) requests arrive server-to-server with no Origin header.
# Vercel gives a project several hostnames — list every one you actually use:
#   https://job-pilot-web-taupe.vercel.app,https://job-pilot-web-usama-bin-nadeem-s-projects.vercel.app
CORS_ORIGINS=http://localhost:3000
# SameSite policy for the refresh cookie: lax | strict | none.
# Use `none` ONLY when the frontend and API sit on unrelated domains (a Vercel
# frontend calling a Railway API). It requires NODE_ENV=production and HTTPS.
COOKIE_SAMESITE=lax

# --- Authentication ------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# AES-256-GCM key for encrypting sensitive columns at rest (32 bytes, base64).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# --- OAuth (optional; leave blank to disable the provider) --------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/auth

# --- File storage --------------------------------------------------------
# `local` (dev) or `s3` (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional ClamAV daemon for upload scanning (see docs/SECURITY.md).
CLAMAV_HOST=
CLAMAV_PORT=

# --- LLM providers -------------------------------------------------------
# Which provider the LLM abstraction layer uses by default: openai | anthropic | mock
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Embeddings provider for vector search (optional): openai | none
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=

# --- Job sources ---------------------------------------------------------
# Each adapter is disabled unless its credentials/config are present.
# The API reports "<source> is not configured" instead of failing silently.

# Greenhouse / Lever / Ashby public job-board endpoints need no credentials.
# Provide the company board tokens you want to track (comma-separated slugs).
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_SLUGS=
ASHBY_JOB_BOARD_NAMES=

# Adzuna — https://developer.adzuna.com (free tier, official API)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Jooble — https://jooble.org/api/about (official API key)
JOOBLE_API_KEY=

# Partner-only platforms. These stay disabled until you hold a signed
# partner agreement; the adapters never scrape the consumer web sites.
LINKEDIN_PARTNER_API_TOKEN=
INDEED_PARTNER_API_TOKEN=
GLASSDOOR_PARTNER_API_TOKEN=

# Politeness settings applied to every outbound source request.
HTTP_USER_AGENT=JobPilot/0.1 (+https://example.com/bot; contact@example.com)
SOURCE_REQUESTS_PER_MINUTE=30
RESPECT_ROBOTS_TXT=true

# --- Outreach (optional; user-approved sends only) -----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend -------------------------------------------------------------
# Where the web app forwards its /api/* requests. Server-side only: the
# browser calls the web app's own origin and Next proxies from there, so the
# backend URL is never shipped to the client, no CORS is involved, and the
# session cookie stays first-party.
#
# Local:      http://localhost:4000
# Production: https://<your-api-project>.vercel.app
API_PROXY_TARGET=http://localhost:4000

# Optional override that makes the browser call a backend DIRECTLY, bypassing
# the proxy. Doing so requires the API's CORS_ORIGINS to list this app's origin
# and COOKIE_SAMESITE=none. Leave unset unless you specifically need it —
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so a
# wrong value ships to every visitor and cannot be changed without a rebuild.
# NEXT_PUBLIC_API_URL=
