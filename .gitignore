node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
.turbo/
.env
.env.local
.env.*.local
!.env.example
# Anchored to the repository root on purpose. A bare "storage/" matches a
# directory of that name at any depth, which silently excluded the API's
# storage *module* — source that has to be committed for the build to work.
/storage/
/uploads/
apps/*/storage/

# Anywhere secrets get pasted. .env is covered above, but a file named
# env.txt or api-service.env is the same thing with a different name, and
# only one of them needs to slip through once.
env.txt
*.env
!.env.example
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
